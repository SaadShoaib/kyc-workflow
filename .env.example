# "anthropic" (paid, best quality) or "ollama" (free, runs locally)
LLM_PROVIDER=anthropic

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here

# Only used if LLM_PROVIDER=ollama — override if you're using different local models
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_TEXT_MODEL=llama3.1
