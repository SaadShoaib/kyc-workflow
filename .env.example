# "anthropic" (paid, best quality), "gemini" (free tier, hosted), "mistral" (free tier, hosted), or "ollama" (free, runs locally)
LLM_PROVIDER=anthropic

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here

# Only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# Override the default model — e.g. swap free-tier models to dodge rate limits
GEMINI_MODEL=gemini-3.6-flash

# Only needed if LLM_PROVIDER=mistral
MISTRAL_API_KEY=your-key-here
MISTRAL_MODEL=mistral-small-latest

# Only used if LLM_PROVIDER=ollama — override if you're using different local models
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_TEXT_MODEL=llama3.1

# n8n webhook fired after a reviewer escalates/rejects an applicant (workflow #2).
# Left blank until that n8n workflow exists — send_reason_notification() no-ops without it.
N8N_REASON_WEBHOOK_URL=
NOTIFICATION_RECIPIENT_EMAIL=

# n8n webhook fired when the pipeline pauses at review (workflow #1).
N8N_REVIEW_WEBHOOK_URL=

# Used to build the review_url sent to n8n. Update after deploying.
APP_BASE_URL=http://127.0.0.1:8000
